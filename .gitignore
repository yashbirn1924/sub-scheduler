# ---- private deployment layer (never commit) ----
# Real branding + data-source override
config.local.js
# Real school data (roster, schedules, source spreadsheet, normalizer notes)
/data/real/
# Real branding assets (keep the neutral assets/logo.svg tracked)
/assets/*-logo.png
